# Канонический домен сайта. ОБЯЗАТЕЛЕН на продакшене:
# из него собираются canonical, sitemap.xml, robots.txt и Open Graph.
# Без него используется значение по умолчанию из src/lib/seo.ts, которое,
# скорее всего, не совпадает с реальным доменом.
NEXT_PUBLIC_SITE_URL=https://kosmetolog-citymed.ru

# Подтверждение прав в панелях вебмастеров (значения выдаются в интерфейсе).
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Базовый URL медицинского бэкенда.
# ВНИМАНИЕ: значение по умолчанию — dev-контур (dev-mc-backend.citymed12.ru).
# На продакшене обязательно указать боевой адрес.
NEXT_PUBLIC_API_URL=
